# Rust / Tauri
target/
**/*.rs.bk
*.pdb
# Regenerated by tauri-build on every build. Cargo.lock is deliberately
# NOT ignored: this is a binary crate, so pinning the dependency graph
# is what keeps a build reproducible.
**/gen/schemas/

# Node (the frontend suites' jsdom install; the frontend itself has no
# dependencies and no build step)
node_modules

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local runtime state (written into the app data dir, never the repo,
# but easy to end up with a stray copy while testing by hand)
installs.json
settings.json

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
